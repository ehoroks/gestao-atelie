# Exemplo para desenvolvimento (NAO inclua senhas reais no git).
# O docker-compose.yml le estas mesmas variaveis; copie para .env antes
# de rodar 'docker compose up'.
#
# O Spring Boot NAO le este arquivo automaticamente: exporte as variaveis
# no shell/IDE ou use um arquivo .env carregado pelo seu ambiente.
# No VS Code, configure-as em "Run and Debug" > Environment Variables.

# --- Desenvolvimento local (docker compose) ---
DB_JDBC_URL=jdbc:postgresql://localhost:5432/cirinha_atelie
DB_USERNAME=postgres
DB_PASSWORD=altere_localmente

# --- Supabase ---
# Copie os valores em Project Settings > Database (Connection string / JDBC).
# Recomendado para o backend: Session Pooler (porta 5432), que suporta
# Flyway e prepared statements e fornece IPv4.
#
# DB_JDBC_URL=jdbc:postgresql://<host-do-pooler>:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<senha-do-banco>
#
# Alternativa para ambientes serverless: Transaction Pooler (porta 6543).
# Ele nao mantem prepared statements entre transacoes, por isso use
# prepareThreshold=0. Rode o Flyway em uma etapa separada (conexao direta
# ou Session Pooler) e desligue-o na aplicacao com SPRING_FLYWAY_ENABLED=false.
#
# DB_JDBC_URL=jdbc:postgresql://<host-do-pooler>:6543/postgres?sslmode=require&prepareThreshold=0

# --- Pool de conexoes (opcional) ---
# DB_POOL_MAX_SIZE=5
# DB_POOL_MIN_IDLE=1
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_MAX_LIFETIME_MS=600000
# DB_KEEPALIVE_MS=300000

# --- Flyway (opcional) ---
# DB_CONNECT_RETRIES=5
# DB_CONNECT_RETRIES_INTERVAL=10s

# --- CORS do frontend ---
# Origens autorizadas a chamar a API, separadas por virgula.
# Em desenvolvimento o proxy do Vite dispensa CORS; em producao use o
# dominio real do frontend. Evite '*' com a API publica.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT (obrigatorio) ---
# Segredo HS256 com no minimo 32 caracteres; recomendado 64 aleatorios.
# Gere com: openssl rand -base64 48
# NUNCA versione o valor real: use variavel de ambiente em producao.
JWT_SECRET=altere-para-um-segredo-aleatorio-com-64-caracteres-ou-mais
# Validade do token em minutos (padrao: 120).
JWT_EXPIRATION_MINUTES=120

# --- Primeiro administrador (opcional) ---
# Na primeira subida com estes valores, um usuario ADMIN e criado (idempotente).
# A senha nao e registrada em log. Remova ADMIN_SENHA do ambiente depois do
# primeiro login (o cadastro de novos usuarios e a troca de senha ficam nas
# proximas trilhas).
# ADMIN_EMAIL=admin@atelie.local
# ADMIN_SENHA=uma-senha-forte-com-12-caracteres
# ADMIN_NOME=Administrador
